#!/usr/bin/env bash
# =============================================================================
# docker-setup  (re-run tolerant) V 0.3
# Creates a Docker-contained development service.
# Uses the "pkg" abstraction. Host and guest are expected to be Linux.
# =============================================================================

set -euo pipefail

die()  { echo "docker-setup: $*" >&2; exit 1; }
info() { echo "→ $*"; }
step() { echo "==> $*"; }

# ---------------------------------------------------------------------------
# Required variables
# ---------------------------------------------------------------------------
[[ -n "${DOCKER_SERVICE_NAME:-}" ]] || die "DOCKER_SERVICE_NAME must be defined"
[[ -n "${DOCKER_SERVICE_ROOT:-}" ]] || die "DOCKER_SERVICE_ROOT must be defined"

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
: "${DOCKER_DISTRIBUTION:=ubuntu:latest}"
: "${DOCKER_MEM_LIMIT:=8g}"
: "${DOCKER_CPU_RATIO:=0.33}"
: "${DOCKER_IMAGE_NAME:=${DOCKER_SERVICE_NAME}}"
: "${DOCKER_CONTAINER_NAME:=${DOCKER_SERVICE_NAME}}"
: "${DOCKER_USER:=${USER}}"
: "${DOCKER_GROUP:=${DOCKER_USER}}"
: "${DOCKER_USER_ID:=$(id -u)}"
: "${DOCKER_GROUP_ID:=$(id -g)}"
: "${DOCKER_SHARE:=share-ro}"
: "${DOCKERFILE_INSTRUCTIONS:=}"



DOCKER_SERVICE_ROOT=$(realpath -m "$DOCKER_SERVICE_ROOT")
mkdir -p "$DOCKER_SERVICE_ROOT"
cd "$DOCKER_SERVICE_ROOT"

# ---------------------------------------------------------------------------
# Installing tools...
#----------------------------------------------------------------------------

mkdir -p "$DOCKER_SERVICE_ROOT/bin"

curl -fsSL "https://raw.githubusercontent.com/rokan51/local-bin/refs/heads/main/bin/pkg" \
     -o "$DOCKER_SERVICE_ROOT/bin/pkg"
chmod +x "$DOCKER_SERVICE_ROOT/bin/pkg"

# Make them available for the rest of this script
export PATH="$DOCKER_SERVICE_ROOT/bin:$PATH"


# ---------------------------------------------------------------------------
# Shared directories (host side)
# ---------------------------------------------------------------------------
step "Creating shared directories"

mkdir -p "$DOCKER_SERVICE_ROOT/$DOCKER_USER"
chmod 2775 "$DOCKER_SERVICE_ROOT/$DOCKER_USER"          # rwxrwsr-x

mkdir -p "$DOCKER_SERVICE_ROOT/$DOCKER_USER/.local/bin"

mkdir -p "$DOCKER_SERVICE_ROOT/$DOCKER_SHARE"
chmod 2755 "$DOCKER_SERVICE_ROOT/$DOCKER_SHARE"         # rwxr-sr-x

# ---------------------------------------------------------------------------
# CPU limit
# ---------------------------------------------------------------------------
NCPU=$(nproc)
DOCKER_CPU_LIMIT=$(awk -v n="$NCPU" -v r="$DOCKER_CPU_RATIO" 'BEGIN {
    c = int(n * r); if (c < 1) c = 1; print c
}')
info "Resource limits → memory: $DOCKER_MEM_LIMIT   cpus: $DOCKER_CPU_LIMIT (of $NCPU)"

# ---------------------------------------------------------------------------
# Dockerfile
# ---------------------------------------------------------------------------
step "Writing Dockerfile"

cat > "$DOCKER_SERVICE_ROOT/Dockerfile" << EOF
FROM ${DOCKER_DISTRIBUTION}
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

# Create matching user/group
RUN set -eux;\\
  userdel -r ${DOCKER_USER_ID} || true; \\
  groupdel ${DOCKER_GROUP_ID} || true; 

RUN  groupadd --gid ${DOCKER_GROUP_ID} ${DOCKER_GROUP} 
RUN  useradd  --uid ${DOCKER_USER_ID} --gid ${DOCKER_GROUP_ID} \\
              --home-dir /home/${DOCKER_USER} --no-create-home \\
              --shell /bin/bash ${DOCKER_USER}
RUN mkdir -p /home/${DOCKER_USER} \\
  && chown ${DOCKER_USER}:${DOCKER_GROUP} /home/${DOCKER_USER}

# Passwordless sudo
RUN echo "${DOCKER_USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${DOCKER_USER} \\
 && chmod 0440 /etc/sudoers.d/${DOCKER_USER}
 
COPY --chmod=755 ./bin/* /usr/local/bin/

# Service-specific instructions (provided by the caller)
${DOCKERFILE_INSTRUCTIONS}

USER ${DOCKER_USER}
WORKDIR /home/${DOCKER_USER}
ENV HOME=/home/${DOCKER_USER}

CMD ["sleep", "infinity"]
EOF

# ---------------------------------------------------------------------------
# docker-compose.yml
# ---------------------------------------------------------------------------
step "Writing docker-compose.yml"

cat > "$DOCKER_SERVICE_ROOT/docker-compose.yml" << EOF
services:
  ${DOCKER_SERVICE_NAME}:
    image: ${DOCKER_IMAGE_NAME}
    build:
      context: .
      dockerfile: Dockerfile
    container_name: ${DOCKER_CONTAINER_NAME}
    user: "${DOCKER_USER_ID}:${DOCKER_GROUP_ID}"
    mem_limit: ${DOCKER_MEM_LIMIT}
    memswap_limit: ${DOCKER_MEM_LIMIT}
    cpus: ${DOCKER_CPU_LIMIT}
    volumes:
      - ./${DOCKER_USER}:/home/${DOCKER_USER}
      - ./${DOCKER_SHARE}:/${DOCKER_SHARE}:ro
    working_dir: /home/${DOCKER_USER}
    stdin_open: true
    tty: true
    restart: unless-stopped
EOF

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Build (with automatic docker-group handling)
# ---------------------------------------------------------------------------
step "Building image '${DOCKER_IMAGE_NAME}'"

ensure_host_docker() {
  if command -v docker >/dev/null 2>&1 && docker info &>/dev/null; then
    info "Docker is already usable on the host."
    return 0
  fi

  info "Docker not usable on host – installing via pkg …"

  # pkg must be on PATH (the calling wrapper normally puts the downloaded
  # copy there, or the user has it installed system-wide)
  command -v pkg >/dev/null 2>&1 || die "pkg not found on PATH"

  sudo pkg update
  # upgrade is optional and can be slow; omit or make it configurable
  # sudo pkg upgrade
  sudo pkg install docker-meta
  sudo pkg enable docker
  sudo pkg start docker
}

ensure_host_docker

ensure_docker_access() {
  # Already works?
  if docker info &>/dev/null; then
    return 0
  fi

  # Not a member of the docker group?
  if ! groups | grep -q '\bdocker\b'; then
    info "Current user ($USER) is not in the 'docker' group."
    if sudo -n true 2>/dev/null || sudo -v; then
      sudo usermod -aG docker "$USER"
      info "Added $USER to the docker group."
    else
      die "Need sudo privileges to add $USER to the docker group."
    fi
  fi

  # Group membership is updated, but the current shell does not see it yet.
  # Prefer 'sg' so we can finish the build without forcing a re-login.
  if command -v sg >/dev/null 2>&1; then
    info "Using 'sg docker' for this build (new group membership not yet active in this shell)."
    return 1          # tell caller to use sg
  fi

  die "Docker group membership was updated, but this shell still cannot talk to the daemon.
    Please run:
       newgrp docker
   (or log out and back in) and then re-execute the setup script."
}

if ensure_docker_access; then
  docker compose build --no-cache
else
  # ensure_docker_access returned 1 → use sg
  sg docker -c "cd '$DOCKER_SERVICE_ROOT' && docker compose build --no-cache"
fi



# ---------------------------------------------------------------------------
# Done
# ---------------------------------------------------------------------------
cat << EOF

====================================================================
  Docker environment for '${DOCKER_SERVICE_NAME}' is ready
====================================================================

Next steps (from ${DOCKER_SERVICE_ROOT}):

  0. Create & start the container (once):
       docker compose up -d

  1. Enter an interactive shell:
       docker compose exec ${DOCKER_SERVICE_NAME} bash -l

  2. Stop / start later:
       docker compose stop
       docker compose start

  3. Destroy everything:
       docker compose down

Resources : ${DOCKER_MEM_LIMIT} RAM, ${DOCKER_CPU_LIMIT} CPUs
Passwordless sudo is enabled inside the container.
Docker socket is intentionally NOT mounted.

EOF
