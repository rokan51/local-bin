#!/usr/bin/env bash
# =============================================================================
# docker-setup  (re-run tolerant) V 0.4
# Creates a Docker-contained development service.
# Uses the "pkg" abstraction. Host and guest are expected to be Linux.
# =============================================================================

set -euo pipefail

die()  { echo "docker-setup: $*" >&2; exit 1; }
info() { echo "→ $*"; }
step() { echo "==> $*"; }

# ---------------------------------------------------------------------------
# Required variables
# ---------------------------------------------------------------------------
[[ -n "${DOCKER_SERVICE_NAME:-}" ]] || die "DOCKER_SERVICE_NAME must be defined"
[[ -n "${DOCKER_SERVICE_ROOT:-}" ]] || die "DOCKER_SERVICE_ROOT must be defined"

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
: "${DOCKER_DISTRIBUTION:=ubuntu:latest}"
: "${DOCKER_MEM_LIMIT:=8g}"
: "${DOCKER_CPU_RATIO:=0.33}"
: "${DOCKER_IMAGE_NAME:=${DOCKER_SERVICE_NAME}}"
: "${DOCKER_CONTAINER_NAME:=${DOCKER_SERVICE_NAME}}"
: "${DOCKER_USER:=${USER}}"
: "${DOCKER_GROUP:=${DOCKER_USER}}"
: "${DOCKER_USER_ID:=$(id -u)}"
: "${DOCKER_GROUP_ID:=$(id -g)}"
: "${DOCKER_SHARE:=share}"
: "${DOCKERFILE_INSTRUCTIONS:=}"

DOCKER_SERVICE_ROOT=$(realpath -m "$DOCKER_SERVICE_ROOT")
mkdir -p "$DOCKER_SERVICE_ROOT"
cd "$DOCKER_SERVICE_ROOT"

# ---------------------------------------------------------------------------
# Installing tools...
#----------------------------------------------------------------------------

mkdir -p "$DOCKER_SERVICE_ROOT/bin"

curl -fsSL "https://raw.githubusercontent.com/rokan51/local-bin/refs/heads/main/bin/pkg" \
     -o "$DOCKER_SERVICE_ROOT/bin/pkg"
chmod +x "$DOCKER_SERVICE_ROOT/bin/pkg"

# Make them available for the rest of this script
export PATH="$DOCKER_SERVICE_ROOT/bin:$PATH"


# ---------------------------------------------------------------------------
# Shared directories (host side)
# ---------------------------------------------------------------------------
step "Creating shared directories"

mkdir -p "$DOCKER_SERVICE_ROOT/$DOCKER_USER"
chmod 2775 "$DOCKER_SERVICE_ROOT/$DOCKER_USER"          # rwxrwsr-x

mkdir -p "$DOCKER_SERVICE_ROOT/$DOCKER_USER/.local/bin"

mkdir -p "$DOCKER_SERVICE_ROOT/$DOCKER_SHARE"
chmod 2755 "$DOCKER_SERVICE_ROOT/$DOCKER_SHARE"         # rwxr-sr-x
touch "$DOCKER_SERVICE_ROOT/$DOCKER_SHARE/.THIS-IS-RO-SHARE"

# ---------------------------------------------------------------------------
# CPU limit
# ---------------------------------------------------------------------------
NCPU=$(nproc)
DOCKER_CPU_LIMIT=$(awk -v n="$NCPU" -v r="$DOCKER_CPU_RATIO" 'BEGIN {
    c = int(n * r); if (c < 1) c = 1; print c
}')
info "Resource limits → memory: $DOCKER_MEM_LIMIT   cpus: $DOCKER_CPU_LIMIT (of $NCPU)"

# ---------------------------------------------------------------------------
# Dockerfile
# ---------------------------------------------------------------------------
step "Writing Dockerfile"

cat > "$DOCKER_SERVICE_ROOT/Dockerfile" << EOF
FROM ${DOCKER_DISTRIBUTION}
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8

# Create matching user/group
RUN set -eux; \\
    userdel -r ubuntu  2>/dev/null || true; \\
    userdel -r debian  2>/dev/null || true; \\
    groupdel ubuntu    2>/dev/null || true; \\
    groupdel debian    2>/dev/null || true; \\
    groupadd --gid ${DOCKER_GROUP_ID} ${DOCKER_GROUP}; \\ 
    useradd  --uid ${DOCKER_USER_ID} --gid ${DOCKER_GROUP_ID} \\
              --home-dir /home/${DOCKER_USER} --no-create-home \\
              --shell /bin/bash ${DOCKER_USER}; \\
    mkdir -p /home/${DOCKER_USER}; \\
    chown ${DOCKER_USER}:${DOCKER_GROUP} /home/${DOCKER_USER}

# Passwordless sudo
RUN mkdir -p /etc/sudoers.d \\
 && echo "${DOCKER_USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${DOCKER_USER} \\
 && chmod 0440 /etc/sudoers.d/${DOCKER_USER}
 
COPY --chmod=755 ./bin/* /usr/local/bin/

# Service-specific instructions (provided by the caller)
${DOCKERFILE_INSTRUCTIONS}

USER ${DOCKER_USER}
WORKDIR /home/${DOCKER_USER}
ENV HOME=/home/${DOCKER_USER}

CMD ["sleep", "infinity"]
EOF

# ---------------------------------------------------------------------------
# docker-compose.yml
# ---------------------------------------------------------------------------
step "Writing docker-compose.yml"

cat > "$DOCKER_SERVICE_ROOT/docker-compose.yml" << EOF
services:
  ${DOCKER_SERVICE_NAME}:
    image: ${DOCKER_IMAGE_NAME}
    build:
      context: .
      dockerfile: Dockerfile
    container_name: ${DOCKER_CONTAINER_NAME}
    user: "${DOCKER_USER_ID}:${DOCKER_GROUP_ID}"
    mem_limit: ${DOCKER_MEM_LIMIT}
    memswap_limit: ${DOCKER_MEM_LIMIT}
    cpus: ${DOCKER_CPU_LIMIT}
    volumes:
      - ./${DOCKER_USER}:/home/${DOCKER_USER}
      - ./${DOCKER_SHARE}:/${DOCKER_SHARE}:ro
    working_dir: /home/${DOCKER_USER}
    stdin_open: true
    tty: true
    restart: unless-stopped
EOF


# ---------------------------------------------------------------------------
# docker compose ...  wrapper for service ${DOCKER_SERVICE_NAME}
# ---------------------------------------------------------------------------
step "Writing " ${DOCKER_SERVICE_NAME} wrapper"

cat > "$DOCKER_SERVICE_ROOT/$DOCKER_SERVICE_NAME" << EOF

DOCKER_SERVICE_ROOT="$DOCKER_SERVICE_ROOT"
DOCKER_SERVICE_NAME="$DOCKER_SERVICE_NAME"

cd "\$DOCKER_SERVICE_ROOT/\$DOCKER_SERVICE_NAME"

case "\${1:-}" in
  attach|exec|export|port|run)
    action="\$1"
    shift
    n=1
    while (( n <= \$# )) && [[ \${!n} == -* ]]; do
      ((n++))
    done
    docker compose \$action "\${@:1:n-1}" "$DOCKER_SERVICE_NAME" "\${@:n}"
    ;;
  wait)
    action="\$1"
    shift
    docker compose \$action "\$@"
    ;;
  *)
    docker compose "\$DOCKER_SERVICE_NAME" "\$@"
    ;;
esac

exit \$?

EOF

exit 0
