#!/usr/bin/env bash
# ----------------------------------------------------------
# Wrapper that prepares a docker container wint an agentic client
# environment using docker-setup. Please set following 
# ----------------------------------------------------------

# Service name. Can ve called like "agent-build", or simply "agent"
export DOCKER_SERVICE_NAME="agent"

# Service/docker default user. It is deliberatelly/recomended nto name differently that $USER.
export DOCKER_USER="agent"

# Service location - we store it in private encrypted space because 2 directories will be created there (see below)
# If commented-out/not-defined, the script directory will be used
export DOCKER_SERVICE_ROOT="${HOME}/Private/docker/${DOCKER_SERVICE_NAME}"


# Thwo directiries accesible from host are mounted to the docker system: 
# - the agents rw home directory  ./$DOCKER_USER    mounted rw as agent's home  /home/$DOCKER_USER in the container
# - general other shared directory ./$DOCKER_SHARE  mounted tor agent read-only under /$DOCKER_SHARE
export DOCKER_SHARE="home/share"

# Installed agentic software. You can install multiple agents. Here is for grok-build
INSTALL_AGENT='RUN curl -fsSL https://x.ai/cli/install.sh | bash && if [ -x /root/.local/bin/grok ]; then cp /root/.local/bin/grok /usr/local/bin/grok; fi || true'

# Image base - distro  the agent service is based for.
export DOCKER_DISTRIBUTION="ubuntu:latest"



#############################################################################################################################################################################


# ------------------------------------------------------------------
# Fetch docker-setup
# ------------------------------------------------------------------

set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export DOCKER_SERVICE_ROOT="${DOCKER_SERVICE_ROOT:=${script_dir}}"


mkdir -p "$DOCKER_SERVICE_ROOT/bin"
curl -fsSL -H "Accept: application/vnd.github.v3.raw" "https://api.github.com/repos/rokan51/local-bin/contents/bin/docker-setup?ref=main" -o "$DOCKER_SERVICE_ROOT/bin/docker-setup"
# curl -fsSL "https://raw.githubusercontent.com/rokan51/local-bin/refs/heads/main/bin/docker-setup" -o "$DOCKER_SERVICE_ROOT/bin/docker-setup"
chmod +x "$DOCKER_SERVICE_ROOT/bin/docker-setup"

# ------------------------------------------------------------------
# Dockerfile instructions (run as root inside the image)
# ------------------------------------------------------------------
COPY_FILES='COPY --chmod=755 ./bin/* /usr/local/bin/'

INSTALL_PACKAGES='RUN pkg update && pkg upgrade && pkg install \
  sudo curl wget git \
  build-essential gcc g++ gdb clang clangd clang-format lld lldb \
  cmake ninja-build pkg-config \
  vim nano mc htop tmux \
  ripgrep fd-find jq valgrind ccache \
  doxygen graphviz \
  python3 python3-pip \
  software-properties-common'

# xmake is not always in the default Ubuntu repos – install via its official script
# This one is temporarily broken, revert to it when fixed
# INSTALL_XMAKE='RUN curl -fsSL https://xmake.io/shget.text | bash && cp /root/.local/bin/xmake /usr/local/bin/ && rm -rf /root/.local /root/.xmake'
INSTALL_XMAKE='RUN curl -fsSL https://raw.githubusercontent.com/xmake-io/xmake/master/scripts/get.sh | bash && cp /root/.local/bin/xmake /usr/local/bin/ && rm -rf /root/.local /root/.xmake'

export DOCKERFILE_INSTRUCTIONS="
  ${COPY_FILES}
  ${INSTALL_PACKAGES}
  ${INSTALL_XMAKE}
  ${INSTALL_AGENT}"

# ------------------------------------------------------------------
# Hand off to the generic docker-setup
# ------------------------------------------------------------------
cd "$DOCKER_SERVICE_ROOT"
"$DOCKER_SERVICE_ROOT/bin/docker-setup"
