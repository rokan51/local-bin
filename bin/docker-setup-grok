#!/usr/bin/env bash
# ----------------------------------------------------------
# Wrapper that prepares a Grok-oriented C++ / agentic build
# environment using docker-setup
# ----------------------------------------------------------


# Name of the service / container
export DOCKER_SERVICE_NAME=grok

# Base directory for this service’s files
export DOCKER_SERVICE_ROOT="${HOME}/Private/docker/${DOCKER_SERVICE_NAME}"

# Image base
export DOCKER_DISTRIBUTION="ubuntu:latest"

# ------------------------------------------------------------------
# Fetch docker-setup
# ------------------------------------------------------------------

set -euo pipefail

mkdir -p "$DOCKER_SERVICE_ROOT/bin"
curl -fsSL "https://raw.githubusercontent.com/rokan51/local-bin/refs/heads/main/bin/docker-setup" \
     -o "$DOCKER_SERVICE_ROOT/bin/docker-setup"
chmod +x "$DOCKER_SERVICE_ROOT/bin/docker-setup"

# ------------------------------------------------------------------
# Dockerfile instructions (run as root inside the image)
# ------------------------------------------------------------------
COPY_FILES='COPY --chmod=755 ./bin/* /usr/local/bin/'

INSTALL_PACKAGES='RUN pkg update && pkg install \
  ca-certificates curl wget git \
  build-essential gcc g++ gdb clang lld lldb \
  cmake ninja-build pkg-config \
  vim nano mc htop tmux \
  ripgrep fd-find jq valgrind ccache \
  doxygen graphviz \
  python3 python3-pip \
  software-properties-common'

# xmake is not always in the default Ubuntu repos – install via its official script
INSTALL_XMAKE='RUN curl -fsSL https://xmake.io/shget.text | bash'

INSTALL_GROK='RUN curl -fsSL https://x.ai/cli/install.sh | bash \
  && if [ -x /root/.local/bin/grok ]; then cp /root/.local/bin/grok /usr/local/bin/grok; fi || true'

export DOCKERFILE_INSTRUCTIONS="
  ${COPY_FILES}
  ${INSTALL_PACKAGES}
  ${INSTALL_XMAKE}
  ${INSTALL_GROK}"

# ------------------------------------------------------------------
# Hand off to the generic docker-setup
# ------------------------------------------------------------------
cd "$DOCKER_SERVICE_ROOT"
"$DOCKER_SERVICE_ROOT/bin/docker-setup"
